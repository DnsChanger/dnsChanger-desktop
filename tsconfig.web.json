{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/vite-env.d.ts",
    "src/renderer/**/*",
    "src/preload/*.d.ts",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/i18n/**/*",
    "src/utils/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist-tsc/web",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@renderer/*": [
        "src/renderer/*"
      ]
    }
  }
}